### This is the docker file for the api 
FROM python:3.11-slim  

WORKDIR /fastapi #This is the working directory that will be used in the container 

COPY backend/app/requirements-api.txt ./requirements.txt

RUN pip install --no-cache-dir torch \
    --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app/main.py ./backend/app/main.py
COPY backend/app/routes/ ./backend/app/routes/

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]